# Environment variables for AI-web-bridge
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─────────────────────────────────────────────
# Browser bridge settings (optional)
# The bridge reads these from process environment variables, not from .env.
# Export them in your shell, or pass --browser/--profile-dir/--cdp-port flags.
# Browser profile keeps bridge cookies separate from your daily browser.
# ─────────────────────────────────────────────
# BROWSER=chrome
# BROWSER_PROFILE_DIR=D:\ArgonChromeProfile
# BROWSER_PROFILE_NAME=Default
# EDGE_PROFILE_DIR=D:\AIWebBridgeEdgeProfile
# CDP_HOST=127.0.0.1
# CDP_PORT=9222
# GEMINI_CDP_PORT=9222
# CHATGPT_PROFILE_DIR=D:\AIWebBridgeChatGPTProfile
# CHATGPT_CDP_PORT=9223
# CLAUDE_PROFILE_DIR=D:\AIWebBridgeClaudeProfile
# CLAUDE_CDP_PORT=9224
