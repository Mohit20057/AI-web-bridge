# Environment variables for AI-web-bridge
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─────────────────────────────────────────────
# Google Stitch (stitch.withgoogle.com)
# Get your key: stitch.withgoogle.com → Profile → Settings → API Key → Create Key
# ─────────────────────────────────────────────
STITCH_API_KEY=your_stitch_api_key_here

# ─────────────────────────────────────────────
# Chrome remote-debugging bridge
# Path to a dedicated Chrome profile for automation (keeps your daily Chrome separate)
# ─────────────────────────────────────────────
CHROME_PROFILE_DIR=D:\ArgonChromeProfile
CHROME_DEBUG_PORT=9222
