# Environment variables for AI-web-bridge
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─────────────────────────────────────────────
# Browser bridge settings (optional)
# The bridge reads these from process environment variables, not from .env.
# Export them in your shell, or pass --browser/--profile-dir/--cdp-port flags.
# Browser profile keeps bridge cookies separate from your daily browser.
# ─────────────────────────────────────────────
# BROWSER=chrome
# BROWSER_MODE=managed
# Use BROWSER_MODE=existing to attach to your already-open signed-in Chrome.
# Requires Chrome 144+, Node.js/npm, Remote Debugging enabled in Chrome, and an approval click.
# Use BROWSER_MODE=extension to use the installed extension on a signed-in AI tab.
# Register it once with: python bridge/argon_bridge.py --extension-setup --extension-id YOUR_EXTENSION_ID
# The local helper uses loopback port 8765 by default.
# BROWSER_PROFILE_DIR=~/ArgonChromeProfile
# BROWSER_PROFILE_NAME=Default
# EDGE_PROFILE_DIR=~/AIWebBridgeEdgeProfile
# CDP_HOST=127.0.0.1
# CDP_PORT=9222
# GEMINI_CDP_PORT=9222
# CHATGPT_PROFILE_DIR=~/AIWebBridgeChatGPTProfile
# CHATGPT_CDP_PORT=9223
# CLAUDE_PROFILE_DIR=~/AIWebBridgeClaudeProfile
# CLAUDE_CDP_PORT=9224
