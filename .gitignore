# ──────────────────────────────────────────────────────────────
#  AI-web-bridge  —  .gitignore
#  Keeps secrets, personal data, and build artefacts out of git
# ──────────────────────────────────────────────────────────────

# ── Secrets & credentials ──────────────────────────────────────
.env
mcp_config.json
*.key
*.pem
*.p12
*.secret

# ── Chrome automation profiles (contain cookies / login sessions) ──
.chrome_profile/
ArgonChromeProfile/
ArgonEdgeProfile/
AIWebBridge*Profile/
ChromeProfile/
chrome-*/
*-chrome-profile/

# ── Bridge output files (personal, not source) ─────────────────
response.md
_argon_response.md
_argon_response_*.md
_argon_comparison_*.md
_argon_response.*.response.md
*.response.md
_live_multi_ai_result*
_argon_response.*.comparison.md
_argon_prompt.txt
_argon_context.json
prompt.txt
argon_answer.md
debug_gemini.png
debug_*.png
# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.egg-info/
dist/
build/
wheels/
.venv/
venv/
env/
.python-version

# ── Node ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*

# ── OS & editor ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json
*.log

# ── Per-project bridge session metadata ────────────────────────
.ai-web-bridge/
demo_*/
demo-*/
